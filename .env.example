# 複製這份檔案為 .env.local 並填入真實值。.env.local 不會提交到 Git。
# 標示 NEXT_PUBLIC_ 的變數會被瀏覽器讀到，其他只在伺服器端使用。

# 網站網址（正式站為 https://hausbyhang.com）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase（第 4 步設定）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 只能在伺服器端使用，絕不可加 NEXT_PUBLIC_ 前綴
SUPABASE_SECRET_KEY=

# Resend 寄信：新詢問的通知信。只在伺服器端使用
RESEND_API_KEY=
# 通知信收件人，不填就寄到 src/lib/site.ts 的公司信箱
INQUIRY_NOTIFY_EMAIL=hanginteriorstudio@gmail.com

# 頻率限制雜湊用的隨機字串，不填就用 SUPABASE_SECRET_KEY
IP_HASH_SALT=
