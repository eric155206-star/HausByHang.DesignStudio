# 複製這份檔案為 .env.local 並填入真實值。.env.local 不會提交到 Git。
# 標示 NEXT_PUBLIC_ 的變數會被瀏覽器讀到，其他只在伺服器端使用。

# 網站網址（正式站為 https://hausbyhang.com）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase（第 4 步設定）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 只能在伺服器端使用，絕不可加 NEXT_PUBLIC_ 前綴
SUPABASE_SECRET_KEY=

# Resend 寄信（第 3 步設定）
RESEND_API_KEY=
INQUIRY_NOTIFY_EMAIL=hanginteriorstudio@gmail.com

# 頻率限制雜湊用的隨機字串
IP_HASH_SALT=
